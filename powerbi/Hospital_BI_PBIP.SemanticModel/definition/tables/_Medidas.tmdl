		displayFolder: 3 Pregunta
		lineageTag: f942934e-1294-47c6-a256-d3bfc42c3fde

	measure Egresos = CALCULATE ( COUNTROWS ( fact_admissions ), USERELATIONSHIP ( fact_admissions[discharge_date_key], dim_date[date_key] ) )
		formatString: #,0
		displayFolder: 3 Pregunta
		lineageTag: 3d4ce65e-9dd9-4c8d-a3f7-9a3668414faf

	measure 'Estancias Abiertas' = CALCULATE ( COUNTROWS ( fact_admissions ), fact_admissions[is_open] = TRUE () ) + 0
		formatString: #,0
		displayFolder: 3 Pregunta
		lineageTag: f553736e-3816-4d2e-a348-787de2f3df82

	/// Oculta: el dataset de origen no trae horas de inicio/fin de cirugía (0 de 1.000 en bronce).
	measure 'Duración Promedio Cirugía (min)' = AVERAGE ( fact_surgeries[duration_minutes] )
		formatString: #,0.0
		isHidden
		displayFolder: 3 Pregunta
		lineageTag: 95d0b6f1-8fc9-445e-9102-15a5a2c54f55

