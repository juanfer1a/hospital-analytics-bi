		lineageTag: 90fb8827-3f2e-4e5c-adcc-82e206fd9c7e

	measure 'Estancia Prom. Cama (días)' = CALCULATE ( [Estancia Promedio (días)], fact_admissions[stay_type] = "Cama" )
