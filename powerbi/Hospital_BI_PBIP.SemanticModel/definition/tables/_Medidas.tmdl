		lineageTag: f7bea59f-74f9-47aa-9cb5-340984849fdd

	measure 'Cirugías Top 10' = VAR _rank = RANKX ( ALLSELECTED ( fact_surgeries[surgery_type] ), [Total Cirugías], , DESC, Skip ) RETURN IF ( _rank <= 10, [Total Cirugías] )
		formatString: #,0
		displayFolder: 3 Pregunta
		lineageTag: 1a1b95e9-bbc7-46e5-b1f6-79f57175f253

	measure 'PA Sistólica (lectura alta)' = CALCULATE ( MAX ( fact_medical_records[systolic_bp] ), fact_medical_records[is_high_bp] = 1 )
		formatString: 0
		displayFolder: 4 Respuesta
		lineageTag: 41d55a7f-fa9d-4061-b8d6-52f51a65ba83

	measure 'PA Diastólica (lectura alta)' = CALCULATE ( MAX ( fact_medical_records[diastolic_bp] ), fact_medical_records[is_high_bp] = 1 )
		formatString: 0
		displayFolder: 4 Respuesta
		lineageTag: 6d2bebb3-b2c4-4e26-a6cd-2535ea4205bd

	measure 'Diagnóstico (lectura alta)' = CALCULATE ( MAX ( fact_medical_records[diagnosis] ), fact_medical_records[is_high_bp] = 1 )
		displayFolder: 4 Respuesta
		lineageTag: 4524cd15-19f2-4c04-8e4c-7517239b34b7

	measure 'Próxima Visita (lectura alta)' = VAR _k = CALCULATE ( MAX ( fact_medical_records[next_visit_date_key] ), fact_medical_records[is_high_bp] = 1 ) RETURN IF ( NOT ISBLANK ( _k ), LOOKUPVALUE ( dim_date[full_date], dim_date[date_key], _k ) )
		formatString: dd/mm/yyyy
		displayFolder: 4 Respuesta
		lineageTag: 24560e4a-54b3-4477-85c4-ba3ad6be5798

	measure 'Cirugías (tarjeta)' = COALESCE ( [Total Cirugías], 0 )
		formatString: #,0
		displayFolder: 3 Pregunta
		lineageTag: 1fdb3aef-4b50-474c-a1fa-4f97f46a7ca3

	measure 'Presión Arterial (lectura alta)' = VAR _s = [PA Sistólica (lectura alta)] RETURN IF ( NOT ISBLANK ( _s ), _s & "/" & [PA Diastólica (lectura alta)] )
		displayFolder: 4 Respuesta
		lineageTag: dd47ade5-cae8-41ba-b1c2-4142f69a5af2

	measure 'Próxima Cita (seguimiento)' = VAR _hb = CALCULATE ( COUNTROWS ( fact_medical_records ), fact_medical_records[is_high_bp] = 1 ) VAR _k = CALCULATE ( MAX ( fact_medical_records[next_visit_date_key] ), fact_medical_records[is_high_bp] = 1 ) RETURN IF ( _hb > 0, IF ( ISBLANK ( _k ), "Sin cita programada", FORMAT ( LOOKUPVALUE ( dim_date[full_date], dim_date[date_key], _k ), "yyyy-mm-dd" ) ) )
		displayFolder: 4 Respuesta
		lineageTag: a1f8c35a-3319-4964-9e1c-e62bb8fbe0e6

	measure 'Hipertensos sin Próxima Cita' = COUNTROWS ( FILTER ( VALUES ( dim_patients[patient_key] ), CALCULATE ( COUNTROWS ( fact_medical_records ), fact_medical_records[is_high_bp] = 1 ) > 0 && ISBLANK ( CALCULATE ( MAX ( fact_medical_records[next_visit_date_key] ), fact_medical_records[is_high_bp] = 1 ) ) ) ) + 0
		formatString: #,0
		displayFolder: 4 Respuesta
		lineageTag: 8eb115be-734b-405c-aa9b-dd3394b73e03

