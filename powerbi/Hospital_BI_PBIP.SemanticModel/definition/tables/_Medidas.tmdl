		displayFolder: 2 Complicación
		lineageTag: 82ad9a3f-44e4-469f-b9a5-6330cc794c72

	measure 'Recaudo Efectivo' = CALCULATE ( [Recaudo Citas], fact_appointments[is_completed] = 1 )
		formatString: #,0
		displayFolder: 2 Complicación
		lineageTag: dcc8beb3-18b1-4871-85d2-41715266ff9d

	measure 'Recaudo sin Atención' = [Recaudo Citas] - [Recaudo Efectivo]
		formatString: #,0
		displayFolder: 2 Complicación
		lineageTag: dd995491-8d28-4dde-a767-ce82af8e7e11

	measure 'Ticket Promedio Efectivo' = DIVIDE ( [Recaudo Efectivo], [Citas Completadas] )
		formatString: #,0
		displayFolder: 2 Complicación
		lineageTag: e78bfcf1-ca37-4e65-9ec7-22d98efddd15

	measure 'Recaudo Perdido (estimado)' = [Citas Perdidas] * [Ticket Promedio Efectivo]
		formatString: #,0
		displayFolder: 2 Complicación
		lineageTag: e45fac96-2caa-40d0-8f7b-ed358bf94aca

	measure 'Médicos con Citas' = DISTINCTCOUNT ( fact_appointments[doctor_key] )
