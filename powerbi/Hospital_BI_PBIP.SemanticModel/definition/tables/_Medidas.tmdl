		displayFolder: 2 Complicación
		lineageTag: 2811a03a-e2df-4494-bc1a-b1081ceab2bb

	measure '% Concentración Top Médico' = DIVIDE ( MAXX ( VALUES ( dim_doctors[doctor_key] ), [Total Citas] ), [Total Citas] )
